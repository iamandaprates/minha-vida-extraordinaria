# Copie para .env.local e preencha.
# Sem as chaves do Supabase, a Mive abre em modo local: os mesmos dados reais, salvos neste aparelho (IndexedDB).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Client ID OAuth (tipo "Aplicativo da Web") para conectar o Google Calendar. Opcional.
VITE_GOOGLE_CLIENT_ID=
# Apenas para as skills do Claude Code: token de sessão da pessoa logada (expira em ~1 h).
MIVE_ACCESS_TOKEN=
